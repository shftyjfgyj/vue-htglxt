# =====================================================================
# 本机 Docker 演练用环境变量（仅供本地，切勿用于生产）
# 用法：docker compose -f docker/docker-compose.rehearsal.yml --env-file docker/.env.rehearsal ...
# =====================================================================

# ---------- 本地 MySQL 容器 ----------
MYSQL_ROOT_PASSWORD=Rehearsal2026
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Rehearsal2026
DB_DATABASE=htglxt_v2
DB_CONNECTION_LIMIT=10

# ---------- JWT（演练用固定值，不要复制到生产） ----------
JWT_ACCESS_SECRET=rehearsal9f2c7b41e8a34d5f9c0b7a6d3e1f8c2a4b5d6e7f8091a2b3c4d5e6f708192a3b
JWT_REFRESH_SECRET=rehearsal1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f809
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- 站点 ----------
NODE_ENV=production
PORT=3001
# 演练入口是 http://localhost:8090（web 容器映射端口）
CORS_ORIGIN=http://localhost:8090
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
LOGIN_RATE_LIMIT=50
METRICS_TOKEN=rehearsal-metrics-token

# ---------- 首次迁移（演练"生产空系统"） ----------
SEED_DEMO=false
SEED_ADMIN_PASSWORD=Rehearsal@2026
