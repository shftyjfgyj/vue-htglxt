# =====================================================================
# 生产环境变量（复制为 docker/.env 后逐项填写，切勿提交到仓库）
#   cp docker/.env.production.example docker/.env
#   chmod 600 docker/.env
# =====================================================================

# ---------- 数据库：阿里云 RDS MySQL ----------
# 用【内网地址】，不要用公网地址（更快也更安全）
DB_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=htglxt
DB_PASSWORD=换成你的强密码
DB_DATABASE=htglxt_v2
DB_CONNECTION_LIMIT=20

# ---------- JWT 密钥（生产必须，生成方式：openssl rand -hex 32） ----------
JWT_ACCESS_SECRET=把openssl输出粘到here_access
JWT_REFRESH_SECRET=把openssl输出粘到here_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- 站点 ----------
# 必须与最终访问域名一致，否则浏览器会拦截跨域请求
CORS_ORIGIN=https://your-domain.com
PORT=3001
NODE_ENV=production

# ---------- 运维 ----------
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
# 生产保持默认 20 次/10 分钟；本地跑 E2E 才需要放宽
LOGIN_RATE_LIMIT=20
# 访问 /metrics 的令牌（Prometheus 抓取用；留空则接口返回 401）
METRICS_TOKEN=换成随机字符串

# ---------- 首次迁移 ----------
# false = 只建表 + 基础权限/角色/菜单 + 管理员账号，不灌演示数据（生产推荐）
SEED_DEMO=false
# 管理员初始密码（首次迁移写入，登录后请立即修改）
SEED_ADMIN_PASSWORD=换成强密码
# ---------- 镜像加速（国内 ECS 拉不到 Docker Hub 时必填） ----------
# 把下面三行的注释去掉，并把地址换成你的阿里云容器镜像服务专属加速地址
# （控制台 → 容器镜像服务 → 镜像工具 → 镜像加速器，形如 https://xxxx.mirror.aliyuncs.com）
# NODE_IMAGE=https://xxxx.mirror.aliyuncs.com/library/node:22-bookworm-slim
# NODE_IMAGE_WEB=https://xxxx.mirror.aliyuncs.com/library/node:22-alpine
# NGINX_IMAGE=https://xxxx.mirror.aliyuncs.com/library/nginx:1.27-alpine
# 容器内 npm 安装源（国内建议保持 npmmirror，海外/香港节点可改回 npmjs）
NPM_REGISTRY=https://registry.npmmirror.com
