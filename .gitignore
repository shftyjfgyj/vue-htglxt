# 依赖与构建产物
node_modules/
dist/

# 环境变量（示例文件 .env.example 需要入库）
.env
.env.local

# npm 缓存（离线/受限环境安装时使用）
.npm-cache/
.npm-cache-web/

# 上传目录内容（运行时会自动创建）
apps/server/uploads/

# 本地部署演练用的 nginx（解压即用，不入库）
.tmp-nginx/

# UI 对比截图（可随时用 scripts/ui-shots.mjs 重新生成）
ui-shots/

# 备份与测试产物
backups/
apps/web/test-results/
apps/web/e2e-report/
apps/web/e2e/.auth/
apps/web/playwright-report/

# 日志与临时文件
*.log
logs/
tmp/
.DS_Store

# 临时脚本（历史上用于一次性验证，其中若干硬编码了账号口令，一律不入库）
.tmp-*