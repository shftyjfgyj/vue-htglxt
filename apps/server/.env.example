# 运行环境
NODE_ENV=development
PORT=3001

# MySQL（新库，与老系统 htglxt_db 隔离）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=htglxt_v2
DB_CONNECTION_LIMIT=10

# 数据库 TLS：disable（本地）/ require（云数据库省事接法）/ verify（校验 CA）
# Aiven 等托管 MySQL 强制要求 SSL，连不上先看这里
DB_SSL=disable
DB_SSL_CA=

# JWT（生产环境必须替换，长度 >= 16）
JWT_ACCESS_SECRET=dev-access-secret-please-change
JWT_REFRESH_SECRET=dev-refresh-secret-please-change
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# 跨域白名单（逗号分隔）
CORS_ORIGIN=http://localhost:5173

# 日志级别 trace|debug|info|warn|error
LOG_LEVEL=info

# 慢请求告警阈值（毫秒），超过会打 warn 日志
SLOW_REQUEST_MS=1000

# 登录限流：10 分钟窗口内的尝试次数（生产默认 20，E2E/压测可放宽）
LOGIN_RATE_LIMIT=20

# /metrics 访问令牌（留空则不校验，生产建议设置并只让内网 Prometheus 抓取）
METRICS_TOKEN=

# 种子数据：管理员初始密码
SEED_ADMIN_PASSWORD=Admin@123456

# ============================================================
# 上传文件存储
# ============================================================
# local：写 apps/server/uploads（开发 / 单机 / Docker + 持久卷）
# s3   ：S3 兼容对象存储 —— 免费 PaaS 的容器文件系统是临时的，
#        重新部署或休眠重建后会丢失 uploads 里的封面与头像，线上必须用 s3。
STORAGE_DRIVER=local

# 下面几项仅在 STORAGE_DRIVER=s3 时必填（缺任何一项，服务会在启动时直接报错）
# Cloudflare R2 示例：
#   S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=htglxt
#   S3_ACCESS_KEY_ID=<R2 的 Access Key ID>
#   S3_SECRET_ACCESS_KEY=<R2 的 Secret Access Key>
#   S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   （或在 R2 绑定的自定义域名）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uploads/
